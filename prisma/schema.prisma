// Money is stored as integer cents everywhere (portable + exact).
// Enum-like fields use String because SQLite has no native enums;
// allowed values are enforced in src/lib/domain.ts. This keeps the schema
// portable: to move to Postgres/MySQL, change only `provider` below and
// DATABASE_URL (see README "Switching databases").

generator client {
  provider = "prisma-client-js"
  // Engines for the local machine plus the Alpine images used in Docker/Fargate.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An account holder. Every card and checking account belongs to exactly one
/// user, and all reads are filtered by the signed-in user's id.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  // system | light | dark — validated in src/lib/theme.ts
  theme        String   @default("system")
  createdAt    DateTime @default(now())

  securityQuestions SecurityQuestion[]
  cards             CreditCard[]
  checkingAccounts  CheckingAccount[]
  oneOffExpenses    OneOffExpense[]
}

/// Used only to re-establish access when a password is forgotten. Answers are
/// hashed exactly like passwords — they are credentials, not profile data.
model SecurityQuestion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  question   String
  answerHash String
  position   Int

  @@unique([userId, position])
  @@index([userId])
}

model CreditCard {
  id String @id @default(cuid())

  // Nullable only so the multi-user migration could run without touching
  // existing rows; the first account created claims any such orphans. Every
  // query filters on it, so an unclaimed row is visible to nobody.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  issuer             String?
  lastFour           String?
  creditLimit        Int // cents
  // Auto pay: day of month the payment is withdrawn (1-28 recommended).
  autoPayDay         Int?
  // STATEMENT | FULL | MINIMUM | FIXED | NONE — how much auto pay withdraws.
  autoPayType        String    @default("STATEMENT")
  autoPayFixedAmount Int? // cents, used when autoPayType = FIXED
  minimumPayment     Int       @default(3500) // cents, used when autoPayType = MINIMUM
  // Stable chart color slot (0-7), assigned at creation and never repainted.
  colorSlot          Int       @default(0)
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())

  balanceUpdates CardBalanceUpdate[]
  payments       CardPayment[]
  oneOffExpenses OneOffExpense[]

  @@index([archivedAt])
  @@index([userId])
}

model CardBalanceUpdate {
  id               String   @id @default(cuid())
  cardId           String
  card             CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  totalBalance     Int // cents — full outstanding balance
  statementBalance Int // cents — last month's balance, due this month
  reason           String?
  // SNAPSHOT (user-entered) | PAYMENT (derived from a recorded payment)
  // | CHARGE (derived from a recorded expense on the card)
  kind             String   @default("SNAPSHOT")
  recordedAt       DateTime @default(now())

  oneOffExpense OneOffExpense?

  @@index([cardId, recordedAt])
}

model CardPayment {
  id     String   @id @default(cuid())
  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  amount Int // cents
  note   String?
  paidAt DateTime @default(now())

  @@index([cardId, paidAt])
}

model CheckingAccount {
  id String @id @default(cuid())

  // See the note on CreditCard.userId.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   @default("Checking account")
  createdAt DateTime @default(now())

  updates        CheckingBalanceUpdate[]
  incomes        RecurringIncome[]
  expenses       RecurringExpense[]
  oneTimeIncomes OneTimeIncome[]
  oneOffExpenses OneOffExpense[]

  @@index([userId])
}

/// A purchase recorded by hand, on a card or from checking, together with the
/// balance update it wrote. While that update is still the latest one on its
/// card or account the expense can be corrected or removed cleanly.
model OneOffExpense {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int // cents
  note   String?

  // Exactly one of these is set: where the money came from.
  cardId    String?
  card      CreditCard?      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  accountId String?
  account   CheckingAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  cardUpdateId     String?                @unique
  cardUpdate       CardBalanceUpdate?     @relation(fields: [cardUpdateId], references: [id], onDelete: SetNull)
  checkingUpdateId String?                @unique
  checkingUpdate   CheckingBalanceUpdate? @relation(fields: [checkingUpdateId], references: [id], onDelete: SetNull)

  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

/// Money that arrived once and will not repeat: a transfer from savings, a
/// gift, a reimbursement. Recording one raises the checking balance, and the
/// forecast is told about it so the jump is not read as everyday income.
model OneTimeIncome {
  id        String          @id @default(cuid())
  accountId String
  account   CheckingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name   String
  amount Int // cents

  // TRANSFER | GIFT | REIMBURSEMENT | OTHER — validated in src/lib/domain.ts
  category String  @default("OTHER")
  note     String?

  /// The day the money arrived, at local midnight.
  receivedAt DateTime
  createdAt  DateTime @default(now())

  /// The balance update written when this was recorded, so removing the
  /// entry can take the balance back if nothing has been recorded since.
  balanceUpdateId String?                @unique
  balanceUpdate   CheckingBalanceUpdate? @relation(fields: [balanceUpdateId], references: [id], onDelete: SetNull)

  @@index([accountId, receivedAt])
}

/// A salary or other income that lands on a repeating schedule. Several may
/// run at once, each with its own cadence.
model RecurringIncome {
  id        String          @id @default(cuid())
  accountId String
  account   CheckingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name   String
  amount Int // cents received per occurrence (net pay)

  // MONTHLY | SEMI_MONTHLY | BIWEEKLY | WEEKLY — validated in src/lib/domain.ts
  frequency String

  // MONTHLY and SEMI_MONTHLY pay on fixed days of the month; days past a
  // month's end are clamped to its last day.
  dayOfMonth       Int?
  secondDayOfMonth Int?

  // BIWEEKLY and WEEKLY repeat from a known pay date instead.
  anchorDate DateTime?

  /// First occurrence, at local midnight. Null means the schedule was already
  /// running before it was entered, so it also explains recorded history.
  startDate DateTime?

  active    Boolean   @default(true)
  /// When it was last paused; history after this is not explained by it.
  pausedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, active])
}

/// A known outgoing payment on a repeating schedule — rent, a car lease, a
/// utility bill. `amount` is the expected cost; a bill that varies can be
/// corrected for a single due date with an ExpenseAdjustment.
model RecurringExpense {
  id        String          @id @default(cuid())
  accountId String
  account   CheckingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name   String
  amount Int // cents expected per occurrence

  /// Marks a bill that varies (utilities), so the UI invites a correction
  /// once the real figure is known.
  estimated Boolean @default(false)

  // Same schedule vocabulary as RecurringIncome — see src/lib/domain.ts.
  frequency        String
  dayOfMonth       Int?
  secondDayOfMonth Int?
  anchorDate       DateTime?
  startDate        DateTime?

  active    Boolean   @default(true)
  pausedAt  DateTime?
  createdAt DateTime  @default(now())

  adjustments ExpenseAdjustment[]

  @@index([accountId, active])
}

/// Replaces the expected amount for one due date. Set amount to 0 for a month
/// the bill will not be charged.
model ExpenseAdjustment {
  id        String           @id @default(cuid())
  expenseId String
  expense   RecurringExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// The scheduled occurrence being corrected, at local midnight.
  dueDate DateTime
  amount  Int // actual cents
  note    String?

  createdAt DateTime @default(now())

  @@unique([expenseId, dueDate])
  @@index([dueDate])
}

model CheckingBalanceUpdate {
  id         String   @id @default(cuid())
  accountId  String
  account    CheckingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balance    Int // cents
  reason     String?
  recordedAt DateTime @default(now())

  oneTimeIncome OneTimeIncome?
  oneOffExpense OneOffExpense?

  @@index([accountId, recordedAt])
}
