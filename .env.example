# Copy to .env and adjust.

# Local Postgres from docker compose (`docker compose up -d db`).
DATABASE_URL="postgresql://ledgerline:devpass@localhost:55432/ledgerline?schema=public"

# Accounts are created through the app's signup page — there is no shared
# password. SEED_USERNAME / SEED_PASSWORD only affect `npm run db:seed`.

# Secret used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-too"

# Contact address registered with Let's Encrypt for the AWS deployment.
# Receives certificate expiry warnings. Only used by scripts/deploy.sh.
ACME_EMAIL="you@example.com"
